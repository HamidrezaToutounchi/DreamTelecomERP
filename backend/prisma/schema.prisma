generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES_REP
  SALES_MANAGER
}

enum LeadStatus {
  NEW
  CALLED_NO_ANSWER
  CALLED_REACHED
  MEETING_SCHEDULED
  MEETING_DONE
  CONVERTED
  LOST
}

enum CustomerType {
  CORPORATE
  INDIVIDUAL
  DEALER
}

enum InteractionType {
  PHONE_CALL
  IN_PERSON_MEETING
  ONLINE_MEETING
  EMAIL
  WHATSAPP
  NOTE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  REVISED
}

enum Currency {
  TRY
  USD
  EUR
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum ProductType {
  PHYSICAL
  SOFTWARE
  SERVICE
}

enum AppModule {
  // CRM Modülleri
  LEADS
  CUSTOMERS
  QUOTES
  SALES
  PRODUCTS
  REPORTS
  // Stok & Sevkiyat Modülleri
  STOCK_VIEW
  STOCK_ENTRY
  STOCK_EXIT
  STOCK_ADJUSTMENT
  WAREHOUSES
  SUPPLIERS
  FAULTS
  STOCK_REPORTS
  // Yönetim Modülleri
  USERS
  ROLES
  APPROVAL_SETTINGS
  COMPANIES
  CATEGORIES
  AUDIT_LOGS
}

model AppRole {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("app_roles")
}

model RolePermission {
  id        String    @id @default(uuid())
  roleId    String
  role      AppRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AppModule
  canView   Boolean   @default(false)
  canCreate Boolean   @default(false)
  canEdit   Boolean   @default(false)
  canDelete Boolean   @default(false)
  canCancel Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roleId, module])
  @@map("role_permissions")
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  fullName          String
  phone             String?
  role              Role         @default(SALES_REP)
  isSuperAdmin      Boolean      @default(false)
  appRoleId         String?
  appRole           AppRole?     @relation(fields: [appRoleId], references: [id], onDelete: SetNull)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  assignedLeads     Lead[]       @relation("AssignedLeads")
  createdLeads      Lead[]       @relation("CreatedLeads")
  assignedCustomers Customer[]   @relation("AssignedCustomers")
  createdCustomers  Customer[]   @relation("CreatedCustomers")
  interactions      Interaction[]
  quotes            Quote[]
  sales             Sale[]
  auditLogs         AuditLog[]

  // Stok & Arıza İlişkileri
  stockEntriesCreated   StockEntry[]        @relation("StockEntryCreatedBy")
  stockEntriesCancelled StockEntry[]        @relation("StockEntryCancelledBy")
  stockExitsCreated     StockExit[]         @relation("StockExitCreatedBy")
  stockExitsCancelled   StockExit[]         @relation("StockExitCancelledBy")
  stockExitApprovals    StockExitApproval[]
  stockMovementsCreated StockMovement[]     @relation("StockMovementCreatedBy")
  faultRecordsCreated   FaultRecord[]       @relation("FaultCreatedBy")

  @@map("users")
}

model CustomerCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  color       String     @default("#004A93")
  customers   Customer[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("customer_categories")
}

model Lead {
  id           String       @id @default(uuid())
  companyName  String
  contactName  String
  phone        String
  email        String?
  source       String       @default("Web")
  status       LeadStatus   @default(NEW)
  assignedToId String?
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User         @relation("CreatedLeads", fields: [createdById], references: [id])
  lastActionAt DateTime?
  notes        String?
  customer     Customer?
  interactions Interaction[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("leads")
}

model Customer {
  id            String            @id @default(uuid())
  type          CustomerType      @default(CORPORATE)
  companyName   String            // Firma ünvanı veya Bireysel Müşteri Adı Soyadı
  categoryId    String?
  category      CustomerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxNumber     String?
  taxOffice     String?
  contactPerson String
  phone         String
  email         String?
  address       String?
  leadId        String?           @unique
  lead          Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedToId  String
  assignedTo    User              @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User              @relation("CreatedCustomers", fields: [createdById], references: [id])
  source        String?           @default("CRM")
  interactions  Interaction[]
  quotes        Quote[]
  sales         Sale[]
  stockExits    StockExit[]
  faultRecords  FaultRecord[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("customers")
}

model Interaction {
  id               String          @id @default(uuid())
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  type             InteractionType
  contactedPerson  String
  summary          String          @db.Text
  nextFollowUpDate DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("interactions")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  brand       String?
  model       String?
  type        ProductType @default(PHYSICAL)
  code        String?     @unique
  description String?     @db.Text
  unitPrice   Decimal     @default(0) @db.Decimal(15, 2)
  currency    Currency    @default(TRY)
  taxRate     Int         @default(20)
  imageUrl    String?
  isActive    Boolean     @default(true)

  // Stok & Garanti Alanları
  trackSerial             Boolean          @default(false)
  trackMac                Boolean          @default(false)
  macRequired             Boolean          @default(false)
  customerWarrantyMonths  Int              @default(24)
  supplierWarrantyMonths  Int              @default(24)
  minStockLevel           Decimal          @default(0) @db.Decimal(15, 2)
  unit                    String           @default("ADET")

  barcodes                ProductBarcode[]
  stockLevels             StockLevel[]
  stockEntryItems         StockEntryItem[]
  stockExitItems          StockExitItem[]
  serials                 SerialNumber[]
  movements               StockMovement[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  quoteItems  QuoteItem[]

  @@unique([name, brand, model])
  @@map("products")
}

model Company {
  id              String   @id @default(uuid())
  code            String   @unique // DREAM, TESCOM
  name            String   // Dream Telecom, Tescom Telecom
  title           String   // Resmi Ticari Ünvan
  address         String   @db.Text
  phone           String
  fax             String?
  email           String   @db.Text
  website         String?
  taxOffice       String?
  taxNumber       String?
  bankInfo        String?  @db.Text
  logoUrl         String?
  primaryColor    String   @default("#004A93")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotes          Quote[]

  @@map("companies")
}

model Quote {
  id              String       @id @default(uuid())
  quoteNumber     String       @unique
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id])
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  repId           String
  rep             User         @relation(fields: [repId], references: [id])
  version         Int          @default(1)
  parentQuoteId   String?
  parentQuote     Quote?       @relation("QuoteRevisions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions       Quote[]      @relation("QuoteRevisions")
  status          QuoteStatus  @default(DRAFT)
  rejectionReason String?      @db.Text
  validUntil      DateTime
  currency        Currency     @default(TRY)
  subTotal        Decimal      @db.Decimal(15, 2)
  taxTotal        Decimal      @db.Decimal(15, 2)
  grandTotal      Decimal      @db.Decimal(15, 2)
  notes           String?      @db.Text
  terms           String?      @db.Text
  items           QuoteItem[]
  sales           Sale[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("quotes")
}

model QuoteItem {
  id           String   @id @default(uuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productCode  String?
  brand        String?
  model        String?
  description  String?  @db.Text
  imageUrl     String?
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(15, 2)
  discountRate Decimal  @default(0) @db.Decimal(5, 2)
  taxRate      Int      @default(20)
  lineTotal    Decimal  @db.Decimal(15, 2)

  @@map("quote_items")
}

model Sale {
  id                 String        @id @default(uuid())
  quoteId            String?       @unique
  quote              Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  repId              String
  rep                User          @relation(fields: [repId], references: [id])
  soldItemsSummary   String        @db.Text
  serialOrMacNumbers String[]      @default([])
  totalAmount        Decimal       @db.Decimal(15, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(15, 2)
  remainingAmount    Decimal       @default(0) @db.Decimal(15, 2)
  currency           Currency      @default(TRY)
  isInvoiced         Boolean       @default(false)
  invoiceNumber      String?
  invoiceDate        DateTime?
  paymentStatus      PaymentStatus @default(PENDING)
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("sales")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  userEmail String?
  userRole  Role?
  action    String   // CREATE, UPDATE, DELETE, REASSIGN, CONVERT, LOGIN, etc.
  entity    String   // LEAD, CUSTOMER, QUOTE, SALE, PRODUCT, USER, AUTH
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}

// ==========================================
// STOK & ARIZA MODÜLÜ ENUM VE MODELLERİ
// ==========================================

model Warehouse {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  address       String?         @db.Text
  contactPerson String?
  contactPhone  String?
  isActive      Boolean         @default(true)
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  stockLevels     StockLevel[]
  stockEntries    StockEntry[]
  stockExits      StockExit[]
  sourceMovements StockMovement[] @relation("SourceWarehouse")
  targetMovements StockMovement[] @relation("TargetWarehouse")

  @@map("warehouses")
}

model Supplier {
  id            String          @id @default(uuid())
  code          String          @unique
  name          String
  taxNumber     String?
  taxOffice     String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?         @db.Text
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  stockEntries  StockEntry[]
  serials       SerialNumber[]

  @@map("suppliers")
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("product_barcodes")
}

model StockLevel {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity         Decimal   @default(0) @db.Decimal(15, 2)
  reservedQuantity Decimal   @default(0) @db.Decimal(15, 2)
  updatedAt        DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

enum StockEntryType {
  PURCHASE      // Satın Alma Girişi
  TRANSFER_IN   // Depolar Arası Transfer Girişi
  RETURN_IN     // Müşteri İadesi
  COUNT_SURPLUS // Sayım Fazlası
  OTHER         // Diğer
}

enum StockEntryStatus {
  COMPLETED
  CANCELLED
}

model StockEntry {
  id            String           @id @default(uuid())
  entryNumber   String           @unique // GR-YYYY-NNNN
  type          StockEntryType   @default(PURCHASE)
  status        StockEntryStatus @default(COMPLETED)
  warehouseId   String
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  supplierId    String?
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  invoiceNumber String?
  waybillNumber String?
  entryDate     DateTime         @default(now())
  description   String?          @db.Text
  documentUrl   String?
  documentName  String?
  createdById   String
  createdBy     User             @relation("StockEntryCreatedBy", fields: [createdById], references: [id])
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?            @relation("StockEntryCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items         StockEntryItem[]
  serials       SerialNumber[]

  @@map("stock_entries")
}

model StockEntryItem {
  id           String     @id @default(uuid())
  stockEntryId String
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Restrict)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(15, 2)
  unitPrice    Decimal    @default(0) @db.Decimal(15, 2)
  currency     Currency   @default(TRY)
  createdAt    DateTime   @default(now())

  @@map("stock_entry_items")
}

enum StockExitType {
  SALE_SHIPMENT   // Müşteri Satış Sevkiyatı
  TRANSFER_OUT    // Depolar Arası Transfer Çıkışı
  RETURN_SUPPLIER // Tedarikçiye İade
  COUNT_DEFICIT   // Sayım Eksiği (Fire / Zayi)
  SCRAP           // Hurda
  FAULT_SEND      // Arıza İçin Servise / Müşteriye Gönderim
  OTHER           // Diğer
}

enum StockExitStatus {
  PENDING_APPROVAL // Onay Bekliyor
  APPROVED         // Onaylandı (Sevk Edilebilir)
  SHIPPED          // Sevk Edildi
  CANCELLED        // İptal Edildi
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  BYPASSED
}

model StockExit {
  id              String            @id @default(uuid())
  exitNumber      String            @unique // CK-YYYY-NNNN
  type            StockExitType     @default(SALE_SHIPMENT)
  status          StockExitStatus   @default(PENDING_APPROVAL)
  warehouseId     String
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  waybillNumber   String?
  carrierCompany  String?
  trackingNumber  String?
  recipientPerson String?
  recipientPhone  String?
  deliveryAddress String?           @db.Text
  exitDate        DateTime          @default(now())
  shippedAt       DateTime?
  description     String?           @db.Text
  documentUrl     String?
  documentName    String?
  createdById     String
  createdBy       User              @relation("StockExitCreatedBy", fields: [createdById], references: [id])
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?             @relation("StockExitCancelledBy", fields: [cancelledById], references: [id])
  cancelReason    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items           StockExitItem[]
  approvals       StockExitApproval[]
  serials         SerialNumber[]

  @@map("stock_exits")
}

model StockExitItem {
  id          String    @id @default(uuid())
  stockExitId String
  stockExit   StockExit @relation(fields: [stockExitId], references: [id], onDelete: Restrict)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Decimal   @db.Decimal(15, 2)
  unitPrice   Decimal   @default(0) @db.Decimal(15, 2)
  currency    Currency  @default(TRY)
  createdAt   DateTime  @default(now())

  @@map("stock_exit_items")
}

model StockExitApproval {
  id          String         @id @default(uuid())
  stockExitId String
  stockExit   StockExit      @relation(fields: [stockExitId], references: [id], onDelete: Cascade)
  step        Int            // 1, 2, 3 ...
  roleId      String?
  approverId  String?
  approver    User?          @relation(fields: [approverId], references: [id])
  status      ApprovalStatus @default(PENDING)
  actionDate  DateTime?
  note        String?        @db.Text
  createdAt   DateTime       @default(now())

  @@unique([stockExitId, step])
  @@map("stock_exit_approvals")
}

model ApprovalSetting {
  id          String   @id @default(uuid())
  step        Int      @unique
  name        String
  roleId      String?
  userId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("approval_settings")
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SHIPPED
  IN_FAULT
  SCRAPPED
  RETURNED
}

model SerialNumber {
  id                  String        @id @default(uuid())
  serial              String        @unique
  macAddress          String?       @unique
  productId           String
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  status              SerialStatus  @default(IN_STOCK)
  warehouseId         String?
  supplierId          String?
  supplier            Supplier?     @relation(fields: [supplierId], references: [id])
  stockEntryId        String?
  stockEntry          StockEntry?   @relation(fields: [stockEntryId], references: [id])
  stockExitId         String?
  stockExit           StockExit?    @relation(fields: [stockExitId], references: [id])
  currentCustomerId   String?
  customerWarrantyEnd DateTime?
  supplierWarrantyEnd DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  movements           StockMovement[]
  faults              FaultRecord[]

  @@map("serial_numbers")
}

enum StockMovementType {
  ENTRY
  EXIT
  TRANSFER
  ADJUSTMENT
  CANCEL_REVERSAL
}

model StockMovement {
  id                String            @id @default(uuid())
  type              StockMovementType
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  serialId          String?
  serial            SerialNumber?     @relation(fields: [serialId], references: [id])
  sourceWarehouseId String?
  sourceWarehouse   Warehouse?        @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouseId String?
  targetWarehouse   Warehouse?        @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  quantity          Decimal           @db.Decimal(15, 2)
  previousStock     Decimal           @db.Decimal(15, 2)
  newStock          Decimal           @db.Decimal(15, 2)
  referenceType     String            // 'STOCK_ENTRY', 'STOCK_EXIT', 'FAULT', 'ADJUSTMENT'
  referenceId       String
  createdById       String
  createdBy         User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  description       String?           @db.Text
  createdAt         DateTime          @default(now())

  @@map("stock_movements")
}

enum FaultStatus {
  RECEIVED
  IN_INSPECTION
  WAITING_PARTS
  SENT_TO_SUPPLIER
  RESOLVED
  REPLACED
  SCRAPPED
  RETURNED_TO_CUSTOMER
}

enum FaultPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model FaultRecord {
  id                    String        @id @default(uuid())
  faultNumber           String        @unique // ARZ-YYYY-NNNN
  serialId              String
  serial                SerialNumber  @relation(fields: [serialId], references: [id])
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id])
  contactPerson         String?
  contactPhone          String?
  reportedProblem       String        @db.Text
  status                FaultStatus   @default(RECEIVED)
  priority              FaultPriority @default(MEDIUM)
  underCustomerWarranty Boolean       @default(false)
  underSupplierWarranty Boolean       @default(false)
  technicianNotes       String?       @db.Text
  resolutionSummary     String?       @db.Text
  receivedDate          DateTime      @default(now())
  resolvedDate          DateTime?
  createdById           String
  createdBy             User          @relation("FaultCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  receiptUrl            String?

  @@map("fault_records")
}
